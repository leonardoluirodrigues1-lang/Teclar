# .env.example — modelo do .env, este SIM vai para o git.
# Copie para .env e troque SENHA pela senha do root do seu MySQL local:
#   cp .env.example .env
# Se a senha tiver caractere especial (@ : / # ?), escreva-o codificado
# (ex.: @ vira %40), senão a URL quebra.
# O nome do banco vai em MINÚSCULAS: no Windows o MySQL guarda "teclardb"
# mesmo que o CREATE diga outra coisa, e com "teclarDB" aqui o prisma db pull
# descarta todas as chaves estrangeiras (o schema vem sem relações).
DATABASE_URL="mysql://root:SENHA@localhost:3306/teclardb"

# Segredo que assina os tokens de login (JWT). Qualquer texto longo e
# aleatório; quem tiver este valor consegue forjar um login. Para gerar um:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SEGREDO="TROQUE-POR-UM-SEGREDO-ALEATORIO"
