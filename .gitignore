node_modules/

# Todo .js e .js.map dentro de js/ é GERADO pelo tsc a partir do .ts/.tsx de
# mesmo nome (allowJs está desligado no tsconfig.json: não existe .js fonte
# em js/). A fonte é o .ts/.tsx; o gerado não vai para o git.
#
# Se um dia algum .js de js/ precisar ser versionado, libere só ele aqui
# embaixo com uma linha "!js/caminho/arquivo.js".
js/**/*.js
js/**/*.js.map

# Prints que o npm run test:telas tira quando um cenário falha: são da
# última execução, não do projeto.
testes-telas/falhas/
